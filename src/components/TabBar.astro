---
// Barra de pestañas. Las listas están en src/lib/tabs.ts (una por versión).
import { TABS, type GuideRealm } from '../lib/tabs';

interface Props {
  realm?: GuideRealm;
}
const { realm = 'midnight' } = Astro.props;
const tabs = TABS[realm];
---

<nav class="mk-tabs" aria-label="Secciones de la guía">
  <div class="mk-tabs__inner">
    {tabs.map((t, i) => (
      <button
        type="button"
        class:list={['mk-tab', { active: i === 0, 'mk-tab--cta': t.cta }]}
        data-tab={t.id}
        onclick={`showTab('${t.id}', this)`}
        hidden={t.hidden}
      >
        {t.label}
      </button>
    ))}
  </div>
</nav>
