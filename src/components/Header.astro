---
import { changelog, formatShort } from '../lib/changelog';

// Entradas visibles en la cabecera (el historial completo queda en changelog.json)
const CHANGELOG_VISIBLE = 2;
const recentChanges = changelog.slice(0, CHANGELOG_VISIBLE);
---

<!-- ── TOOLTIP ──────────────────────────────────────────────────── -->
<div class="tooltip" id="tooltip">
  <div class="tooltip-name" id="tt-name"></div>
  <div class="tooltip-type" id="tt-type"></div>
  <div class="tooltip-desc" id="tt-desc"></div>
</div>

<!-- ── HEADER ───────────────────────────────────────────────────── -->
<div class="guide-header">
  <div class="header-inner">
    <div class="header-icon" aria-label="Pack Leader y Dark Ranger" role="img">
      <img
        src="https://assets.rpglogs.com/img/warcraft/talents/hero/43_full.png"
        width="108"
        height="108"
        class="header-icon-layer base"
        alt="Pack Leader"
      />
      <img
        src="https://wow.zamimg.com/images/wow/TextureAtlas/live/talents-heroclass-hunter-darkranger.webp"
        width="108"
        height="108"
        class="header-icon-layer wipe"
        alt="Dark Ranger"
      />
      <span class="header-icon-sweep" aria-hidden="true"></span>
    </div>
    <div class="header-text">
      <div class="header-main-copy">
        <h1>Guía Hunter BM Midnight S2<br> Talentos, Rotación y Builds PvE</h1>
        <p>Talentos, rotación, opener y BiS de Hunter BM para PVE</p>
        <div class="header-hero-note">Hero Talents: Pack Leader y Dark Ranger</div>
      </div>
      <div class="header-action-row">
        <div class="changelog-box">
          <div class="changelog-title">📝 Lista de cambios</div>
          <ul class="changelog-list">
            {recentChanges.map((c) => (
              <li>
                <span class="changelog-date">{formatShort(c.fecha)}:</span>
                {c.texto} <a href={`#${c.pestana}`}>{c.enlace}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ── BUFF BANNER ─────────────────────────────────────────────── -->
<div class="buff-banner">
  <span class="buff-banner-icon">🔥</span>
  <span class="buff-banner-title">PARCHE — 14 de octubre:</span>
  <span class="buff-banner-text">📈 Nueva raid Kith'ix con objetos importantes</span>
  <span class="buff-banner-icon"></span>
</div>
