---
// Pestaña BiS y consumibles (Forever): cabecera con datos, aviso, VENTANA DE PERSONAJE (emblema del Cazador
// en el centro y las 19 ranuras alrededor), consumibles, encantamientos y «Sigue con la guía».
// Estilos: bloque «BIS Y CONSUMIBLES» de forever.css (clases bf-*, más lv-*/gn-* de General/Leveling).
// Datos:
//   - Ranuras: src/lib/ranuras-forever.mjs (orden, qué acepta cada una).
//   - Pieza elegida por ranura: src/content/data/forever-bis-equipo.json → la rellena el EDITOR LOCAL
//     (botón «Objetos BiS» con `npm run dev`), solo con objetos de forever-bis-catalogo.json.
//   - Catálogo (nombre, calidad, icono, ranura, tipo): forever-bis-catalogo.json, generado con
//     `node scripts/gen-forever-catalogo.mjs` y ampliado por el editor local.
//   - Resto (aviso «En construcción», consumibles, encantamientos): forever-bis.json (+ forever-objetos.json, generado
//     con `node scripts/gen-forever-objetos.mjs`).
import data from '../../content/data/forever-bis.json';
import equipo from '../../content/data/forever-bis-equipo.json';
import catalogo from '../../content/data/forever-bis-catalogo.json';
import objetos from '../../content/data/forever-objetos.json';
import { RANURAS } from '../../lib/ranuras-forever.mjs';
import { md } from '../../lib/markup';
import { iconUrl } from '../../lib/spells';
import { tabPath } from '../../lib/seo';
import IndiceForever from './IndiceForever.astro';
import MochilaConsumibles from '../MochilaConsumibles.astro';

type Tipo = 'item' | 'spell';
type Obj = { nombre: string; calidad: number; icono: string };
type Pieza = Obj & { slot: string; tipo: string; nivel: number | null; ranuras: string[]; origen?: string };
const info = (id: number, tipo: Tipo = 'item'): Obj => {
  const o = (objetos as Record<Tipo, Record<string, Obj>>)[tipo][id];
  if (!o) throw new Error(`forever-objetos.json: falta ${tipo} ${id}. Ejecuta node scripts/gen-forever-objetos.mjs`);
  return o;
};
const url = (id: number, tipo: Tipo = 'item') => `https://www.wowhead.com/forever/es/${tipo}=${id}`;
// Consumibles en la «mochila» compartida con Midnight (MochilaConsumibles.astro): `nota` = para qué sirve
const consumibles = data.consumibles.map((g) => ({ ...g, objetos: g.objetos.map((c: { id: number; nota: string; etiqueta?: string }) => { const o = info(c.id); return { nombre: o.nombre, url: url(c.id), icono: o.icono, uso: c.nota, etiqueta: c.etiqueta }; }) }));

// ── Ventana de personaje: una por fase (pre-raid, raid…), con selector arriba ──
type Elegida = { id: number; origen?: string } | null;
type Fase = { boton: string; ranuras: Record<string, Elegida> };
const CAT = catalogo as Record<string, Pieza>;
const fases = Object.entries((equipo as { fases: Record<string, Fase> }).fases).map(([id, f]) => {
  const ranuras = RANURAS.map((r) => {
    const e = f.ranuras[r.id] ?? null;
    const o = e ? CAT[e.id] : null;
    if (e && !o) throw new Error(`forever-bis-equipo.json (${id}): el objeto ${e.id} (${r.id}) no está en forever-bis-catalogo.json`);
    if (o && !o.ranuras.includes(r.id)) throw new Error(`forever-bis-equipo.json (${id}): «${o.nombre}» no va en la ranura ${r.id}`);
    return { ...r, id_obj: e?.id, o, origen: e?.origen || '' };
  });
  const dosManos = ranuras.find((r) => r.id === 'principal')?.o?.slot === 'Dos manos';
  const usadas = ranuras.filter((r) => !(dosManos && r.id === 'secundaria'));
  return { id, boton: f.boton, ranuras, dosManos, usadas, nElegidas: usadas.filter((r) => r.o).length };
});
const imagen = (equipo as { imagen?: string | null }).imagen;

const INDICE = [
  { id: 'bf-equipo', texto: 'Equipo BiS' },
  { id: 'bf-consumibles', texto: 'Consumibles' },
  { id: 'bf-encant', texto: 'Encantamientos' },
];
---

<div class="lv gn bf-pagina" id="bf">
  <div class="gn-hero">
    <p set:html={md(data.resumen)} />
    <ul class="gn-datos">
      {data.datos.map((d) => <li><b>{d.valor}</b><span>{d.texto}</span></li>)}
    </ul>
  </div>

  <IndiceForever items={INDICE} />

  <p class="lv-demo gn-aviso" set:html={md(data.aviso)} />

  <section class="lv-sec" id="bf-equipo">
    <h3>Equipo BiS del Cazador de Bestias por ranura</h3>
    <p class="lv-lead">La mejor pieza de nivel 60 para cada hueco de la ventana de personaje del Hunter BM, antes de raid (pre-raid) y en raid. Pulsa un objeto para abrirlo en Wowhead.</p>
    {fases.length > 1 && (
      <div class="toggle-wrap bf-fases" role="group" aria-label="Fase del equipo">
        {fases.map((f, i) => <button type="button" class:list={['toggle-btn', 'bf-fase', { active: i === 0 }]} data-bf-fase={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.boton}</button>)}
      </div>
    )}
    {fases.map((f, i) => (
      <div class="bf-fase-panel" data-bf-fase-panel={f.id} hidden={i > 0}>
        {f.nElegidas === 0 && data.construccion && (
          <div class="box box-warn bf-obras">
            <div class="box-title">En construcción</div>
            <p set:html={md(data.construccion)} />
          </div>
        )}
        <div class="bf-pj" data-elegidas={f.nElegidas}>
          {['izq', 'der', 'armas'].map((l) => (
            <ul class:list={['bf-col', `bf-col--${l}`]} aria-label={l === 'armas' ? 'Armas y munición' : l === 'izq' ? 'Armadura (1)' : 'Armadura (2) y accesorios'}>
              {f.ranuras.filter((r) => r.lado === l).map((r) => {
                const bloqueada = f.dosManos && r.id === 'secundaria';
                const Tag = r.o ? 'a' : 'div';
                return (
                  <li class:list={['bf-ranura', r.o ? `q${r.o.calidad}` : 'is-vacia', { 'is-bloqueada': bloqueada }]} data-bf-ranura={r.id}>
                    <Tag class="bf-ranura__in" {...(r.o ? { href: url(r.id_obj!), target: '_blank', rel: 'noopener', 'data-wh-icon-added': 'true' } : {})}>
                      <span class="bf-ranura__icono">
                        <img src={iconUrl(r.o ? r.o.icono : r.icono)} alt="" width="52" height="52" loading="lazy" />
                      </span>
                      <span class="bf-ranura__txt">
                        <small>{r.label}</small>
                        {r.o ? <b>{r.o.nombre}</b> : <b class="bf-ranura__vacio">{bloqueada ? 'Ocupada por el arma de dos manos' : 'Por decidir'}</b>}
                        {r.o ? (r.origen && <em set:html={md(r.origen)} />) : (!bloqueada && r.nota && <em>{r.nota}</em>)}
                      </span>
                    </Tag>
                  </li>
                );
              })}
            </ul>
          ))}

          <figure class="bf-centro">
            <div class:list={['bf-emblema', { 'has-imagen': imagen }]}>
              {imagen
                ? <img class="bf-emblema__img" src={imagen} alt="Cazadores de WoW Forever" loading="lazy" />
                : <span class="bf-emblema__aro"><img src={iconUrl('classicon_hunter')} alt="Emblema del Cazador" width="128" height="128" loading="lazy" /></span>}
            </div>
            <figcaption>
              <b>Cazador</b>
              <span>Dominio de bestias</span>
              <span class="bf-centro__cuenta"><strong>{f.nElegidas}</strong> de {f.usadas.length} piezas elegidas</span>
            </figcaption>
            <img class="bf-centro__logo" src="/brand/realms/forever-360.webp" alt="WoW Forever" width="180" height="146" loading="lazy" />
          </figure>
        </div>

        <details class="mk-fold bf-lista">
          <summary>Ver el equipo en lista</summary>
          <div class="lv-table-wrap">
            <table class="lv-table bf-table">
              <caption class="sr-only">{`${f.boton} del Cazador de Bestias en WoW Forever por ranura`}</caption>
              <thead><tr><th>Ranura</th><th>Objeto</th><th>Dónde se consigue</th></tr></thead>
              <tbody>
                {f.usadas.map((r) => (
                  <tr>
                    <td><b>{r.label}</b></td>
                    <td>{r.o
                      ? <a class={`bf-obj q${r.o.calidad}`} href={url(r.id_obj!)} target="_blank" rel="noopener" data-wh-icon-added="true"><img src={iconUrl(r.o.icono)} alt="" width="28" height="28" loading="lazy" />{r.o.nombre}</a>
                      : <span class="bf-pendiente">Por decidir</span>}</td>
                    <td set:html={r.o ? md(r.origen || '—') : '—'} />
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </div>
    ))}
    <script is:inline>
      // Selector de fase (pre-raid / raid): muestra un panel y recuerda la elección en la URL (#bf-raid)
      (() => {
        const bs = document.querySelectorAll('[data-bf-fase]');
        const ver = (id) => {
          bs.forEach((b) => { b.setAttribute('aria-pressed', String(b.dataset.bfFase === id)); b.classList.toggle('active', b.dataset.bfFase === id); });
          document.querySelectorAll('[data-bf-fase-panel]').forEach((p) => (p.hidden = p.dataset.bfFasePanel !== id));
        };
        bs.forEach((b) => b.addEventListener('click', () => {
          ver(b.dataset.bfFase);
          history.replaceState(null, '', b === bs[0] ? location.pathname + location.search : '#bf-' + b.dataset.bfFase);
        }));
        const h = location.hash.replace('#bf-', '');
        if ([...bs].some((b) => b.dataset.bfFase === h)) ver(h);
      })();
    </script>
  </section>

  <section class="lv-sec" id="bf-consumibles">
    <h3>Consumibles</h3>
    <p class="lv-lead" set:html={md(data.consumiblesIntro)} />
    <MochilaConsumibles grupos={consumibles} />
    <p class="gn-consejo" set:html={md(data.extra)} />
  </section>

  <section class="lv-sec" id="bf-encant">
    <h3>Encantamientos</h3>
    <div class="gn-cambios">
      {data.encantamientos.map((e) => {
        const tipo = e.tipo as Tipo;
        const o = info(e.id, tipo);
        // De momento todos «Por confirmar» (Mishuko, 18-11-2026): sin datos de Forever a nivel 60
        return (
          <div class="gn-cambio">
            <img src={iconUrl(o.icono)} alt="" width="48" height="48" loading="lazy" />
            <div>
              <h4>{e.ranura} <span class="gn-tag">Por confirmar</span></h4>
              <p><a class={`bf-obj q${o.calidad}`} href={url(e.id, tipo)} target="_blank" rel="noopener" data-wh-icon-added="true">{o.nombre}</a></p>
              <p set:html={md(e.nota)} />
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="lv-sec" id="bf-siguiente">
    <h3>Sigue con la guía</h3>
    <div class="gn-next">
      {data.siguiente.map((n) => (
        <a class="gn-next__item" href={tabPath('forever', n.tab)}>
          <img src={iconUrl(n.icono)} alt="" width="44" height="44" loading="lazy" />
          <span><b>{n.titulo}</b>{n.texto}</span>
        </a>
      ))}
    </div>
  </section>
</div>
