---
// Pestaña General (Forever): resumen, aviso a Leveling, qué cambia, qué hereda la mascota,
// puntos fuertes/débiles, mecánicas clave, razas y "sigue con…". Mismo diseño que Leveling (clases lv-*).
// Contenido: src/content/data/forever-general.json.
import data from '../../content/data/forever-general.json';
import { getSpell, foreverIcon, iconUrl } from '../../lib/spells';
import { md } from '../../lib/markup';
import { tabPath } from '../../lib/seo';
import IndiceForever from './IndiceForever.astro';

// Seguridad: todo hechizo citado debe existir en spells.json (si no, el build falla)
const citados = new Set<string>();
const recoger = (v: unknown) => {
  if (typeof v === 'string') for (const m of v.matchAll(/\[\[([^\]|>]+)/g)) citados.add(m[1].trim());
  else if (Array.isArray(v)) v.forEach(recoger);
  else if (v && typeof v === 'object') for (const [k, x] of Object.entries(v)) k === 'hechizo' ? citados.add(String(x)) : recoger(x);
};
recoger({ ...data, _ayuda: '' });
const faltan = [...citados].filter((n) => !getSpell(n));
if (faltan.length) throw new Error(`forever-general.json: hechizos que no están en spells.json: ${faltan.join(', ')}`);

const tip = (nombre: string) => {
  const s = getSpell(nombre);
  return { 'data-name': nombre, 'data-type': s?.type ?? '', 'data-desc': s?.desc ?? '' };
};
const INDICE = [
  { id: 'gn-cambios', texto: 'Qué cambia' },
  { id: 'gn-mascota', texto: 'Tu mascota' },
  { id: 'gn-pros', texto: 'Fuertes y débiles' },
  { id: 'gn-mecanicas', texto: 'Mecánicas' },
  { id: 'gn-razas', texto: 'Razas' },
];
---

<div class="lv gn">
  <div class="gn-hero">
    <p set:html={md(data.resumen)} />
    <ul class="gn-datos">
      {data.datos.map((d) => <li><b>{d.valor}</b><span>{d.texto}</span></li>)}
    </ul>
  </div>

  <a class="gn-banner" href={tabPath('forever', 'leveling')}>
    <img src={iconUrl('inv_misc_map_01')} alt="" width="40" height="40" />
    <span><b>¿Estás subiendo de nivel?</b> Talentos, instructor, mascotas y munición del 1 al 60.</span>
    <span class="gn-banner__btn">Guía de leveling →</span>
  </a>

  <IndiceForever items={INDICE} />

  <p class="lv-demo gn-aviso" set:html={md(data.aviso)} />

  <section class="lv-sec" id="gn-cambios">
    <h3>Qué cambia en Forever respecto al Classic original</h3>
    <div class="gn-cambios">
      {data.cambios.map((c) => (
        <div class="gn-cambio">
          <img src={foreverIcon(c.hechizo)} alt="" width="48" height="48" loading="lazy" {...tip(c.hechizo)} />
          <div>
            <h4>{c.nombre ?? c.hechizo} <span class:list={['gn-tag', { 'is-new': c.etiqueta === 'Nuevo' }]}>{c.etiqueta}</span></h4>
            <p set:html={md(c.texto)} />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="lv-sec" id="gn-mascota">
    <h3>Qué hereda tu mascota de tus estadísticas</h3>
    <ul class="gn-stats">
      {data.herencia.stats.map((s) => <li><b>{s.valor}</b><span>{s.texto}</span></li>)}
    </ul>
    <p class="lv-lead" set:html={md(data.herencia.nota)} />
  </section>

  <section class="lv-sec" id="gn-pros">
    <h3>Puntos fuertes y débiles</h3>
    <div class="gn-pros">
      <div class="gn-col gn-col--si">
        <h4>Puntos fuertes</h4>
        <ul class="lv-claves">{data.fuertes.map((t) => <li set:html={md(t)} />)}</ul>
      </div>
      <div class="gn-col gn-col--no">
        <h4>Puntos débiles</h4>
        <ul class="lv-claves">{data.debiles.map((t) => <li set:html={md(t)} />)}</ul>
      </div>
    </div>
  </section>

  <section class="lv-sec" id="gn-mecanicas">
    <h3>Mecánicas clásicas que tienes que dominar</h3>
    <div class="lv-grid">
      {data.mecanicas.map((m) => (
        <div class="lv-card gn-mec">
          <h5><img src={iconUrl(m.icono)} alt="" width="36" height="36" loading="lazy" />{m.titulo}</h5>
          <ul class="lv-claves">{m.filas.map((f) => <li set:html={md(f)} />)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="lv-sec" id="gn-razas">
    <h3>Mejores razas</h3>
    <p class="lv-lead" set:html={md(data.razas.intro)} />
    <div class="gn-razas">
      {data.razas.lista.map((r) => (
        <div class:list={['gn-raza', { 'is-top': r.top }]}>
          <h4>
            {r.raza}
            <span class:list={['gn-fac', `gn-fac--${r.faccion === 'Horda' ? 'h' : r.faccion === 'Alianza' ? 'a' : 'x'}`]}>{r.faccion}</span>
            {r.top && <span class="lv-top">Recomendada</span>}
          </h4>
          <p set:html={md(r.texto)} />
        </div>
      ))}
    </div>
    <p class="gn-consejo" set:html={md(data.razas.consejo)} />
  </section>

  <section class="lv-sec" id="gn-siguiente">
    <h3>Sigue con la guía</h3>
    <div class="gn-next">
      {data.siguiente.map((n) => (
        <a class="gn-next__item" href={tabPath('forever', n.tab)}>
          <img src={iconUrl(n.icono)} alt="" width="44" height="44" loading="lazy" />
          <span><b>{n.titulo}</b>{n.texto}</span>
        </a>
      ))}
    </div>
  </section>
</div>
