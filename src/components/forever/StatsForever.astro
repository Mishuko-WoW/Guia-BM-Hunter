---
// Pestaña Stats (Forever): cabecera con datos, aviso, prioridad de estadísticas en tarjetas numeradas,
// leveling vs nivel 60, notas y «Sigue con la guía». Mismo diseño que General/Leveling (clases lv-*/gn-*, bloque «STATS» en forever.css).
// Contenido: src/content/data/forever-estadisticas.json.
import data from '../../content/data/forever-estadisticas.json';
import { getSpell, iconUrl } from '../../lib/spells';
import { md } from '../../lib/markup';
import { tabPath } from '../../lib/seo';
import IndiceForever from './IndiceForever.astro';
import catalogo from '../../content/data/forever-bis-catalogo.json';
import equipo from '../../content/data/forever-bis-equipo.json';
import { RANURAS } from '../../lib/ranuras-forever.mjs';

// Seguridad: todo hechizo citado debe existir en spells.json (si no, el build falla)
const faltan = [...JSON.stringify(data).matchAll(/\[\[([^\]|>]+)/g)].map((m) => m[1].trim()).filter((n) => !getSpell(n));
if (faltan.length) throw new Error(`forever-estadisticas.json: hechizos que no están en spells.json: ${faltan.join(', ')}`);

const INDICE = [
  { id: 'st-prioridad', texto: 'Prioridad' },
  { id: 'st-golpe', texto: 'Llegar al 8 % de golpe' },
  { id: 'st-fases', texto: 'Leveling y nivel 60' },
  { id: 'st-notas', texto: 'Mascota y melé' },
];
// Golpe del BiS pre-raid: nombre/icono del catálogo y ranura/origen de la lista pre-raid (si una pieza deja de estar, el build falla)
type Obj = { nombre: string; calidad: number; icono: string };
const preraid = equipo.fases.preraid.ranuras as Record<string, { id: number; origen: string } | null>;
const golpe = data.golpe.piezas.map((x) => {
  const o = (catalogo as Record<string, Obj>)[x.id];
  const r = Object.entries(preraid).find(([, v]) => v?.id === x.id);
  if (!o || !r) throw new Error(`forever-estadisticas.json (golpe): el objeto ${x.id} no está en la lista pre-raid`);
  return { ...x, o, ranura: RANURAS.find((z) => z.id === r[0])?.label ?? r[0], origen: r[1]!.origen };
});
const golpeTotal = golpe.reduce((t, x) => t + x.golpe, 0);
---

<div class="lv gn st">
  <div class="gn-hero">
    <p set:html={md(data.resumen)} />
    <ul class="gn-datos">
      {data.datos.map((d) => <li><b>{d.valor}</b><span>{d.texto}</span></li>)}
    </ul>
  </div>

  <IndiceForever items={INDICE} />

  <p class="lv-demo gn-aviso" set:html={md(data.aviso)} />

  <section class="lv-sec" id="st-prioridad">
    <h3>Prioridad de estadísticas</h3>
    <p class="lv-lead">De más a menos importante. Antes de cambiar una pieza, mira qué estadísticas de esta lista sube.</p>
    <ol class="st-rank">
      {data.prioridad.map((s, i) => (
        <li class={`st-rank__item st-rank__item--${i < 2 ? 'top' : i < 4 ? 'alta' : 'baja'}`}>
          <span class="st-rank__n">{i + 1}</span>
          <img src={iconUrl(s.icono)} alt="" width="48" height="48" loading="lazy" />
          <div>
            <h4>{s.nombre} <span class:list={['gn-tag', { 'is-new': i < 2 }]}>{s.etiqueta}</span></h4>
            <p set:html={md(s.texto)} />
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="lv-sec" id="st-golpe">
    <h3>Cómo llegar al 8 % de golpe</h3>
    <p class="lv-lead" set:html={md(data.golpe.intro)} />
    <div class="lv-table-wrap">
      <table class="lv-table lv-table--objetos">
        <thead><tr><th>Pieza</th><th>Ranura</th><th>Golpe</th><th>Dónde</th></tr></thead>
        <tbody>
          {golpe.map((x) => (
            <tr>
              <td><a class={`bf-obj q${x.o.calidad}`} href={`https://www.wowhead.com/forever/es/item=${x.id}`} target="_blank" rel="noopener" data-wh-icon-added="true"><img src={iconUrl(x.o.icono)} alt="" width="28" height="28" loading="lazy" />{x.o.nombre}</a></td>
              <td>{x.ranura}</td>
              <td><b>{x.golpe} %</b></td>
              <td>{x.origen}</td>
            </tr>
          ))}
        </tbody>
        <tfoot><tr><th colspan="2">Total con el pre-raid completo</th><th>{golpeTotal} %</th><th>Tope contra jefes: 8 %</th></tr></tfoot>
      </table>
    </div>
    <p class="lv-lead" set:html={md(data.golpe.nota)} />
  </section>

  <section class="lv-sec" id="st-fases">
    <h3>Subiendo de nivel y a nivel 60</h3>
    <div class="gn-pros">
      <div class="gn-col st-col--lv">
        <h4>Subiendo de nivel</h4>
        <ul class="lv-claves">{data.fases.leveling.map((t) => <li set:html={md(t)} />)}</ul>
      </div>
      <div class="gn-col st-col--raid">
        <h4>A nivel 60 (raid)</h4>
        <ul class="lv-claves">{data.fases.raid.map((t) => <li set:html={md(t)} />)}</ul>
      </div>
    </div>
  </section>

  <section class="lv-sec" id="st-notas">
    <h3>Tu mascota y el arma cuerpo a cuerpo</h3>
    <div class="gn-cambios">
      {data.notas.map((n) => (
        <div class="gn-cambio">
          <img src={iconUrl(n.icono)} alt="" width="48" height="48" loading="lazy" />
          <div>
            <h4>{n.titulo}</h4>
            <p set:html={md(n.texto)} />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="lv-sec" id="st-siguiente">
    <h3>Sigue con la guía</h3>
    <div class="gn-next">
      {data.siguiente.map((n) => (
        <a class="gn-next__item" href={tabPath('forever', n.tab)}>
          <img src={iconUrl(n.icono)} alt="" width="44" height="44" loading="lazy" />
          <span><b>{n.titulo}</b>{n.texto}</span>
        </a>
      ))}
    </div>
  </section>
</div>
