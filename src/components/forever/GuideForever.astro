---
// Guía WoW Forever: cabecera, pestañas y SOLO la sección de la página actual (una página por pestaña).
// "rotacion" incluye también el panel "opener".
import Header from '../Header.astro';
import TabBar from '../TabBar.astro';
import SeccionForever from './SeccionForever.astro';
import CalculadoraTalentos from './CalculadoraTalentos.astro';
import RangosEntrenables from './RangosEntrenables.astro';
import MascotasForever from './MascotasForever.astro';
import SeccionCoaching from '../SeccionCoaching.astro';
import { TABS_FOREVER } from '../../lib/tabs';
import { SEO } from '../../lib/seo';
import { formatLong, latestChangeDate } from '../../lib/changelog';
import type { CollectionEntry } from 'astro:content';
import '../../styles/forever.css';

interface Props {
  tab?: string;
  paginas: Map<string, CollectionEntry<'foreverPaginas'>>;
}
const { tab = 'mecanicas', paginas } = Astro.props;
const lastUpdate = latestChangeDate(undefined, 'forever');
const visibles = TABS_FOREVER.filter((t) => t.id === tab || (tab === 'rotacion' && t.id === 'opener'));
---

<Header realm="forever" subtitulo={SEO.forever[tab]?.h1sub} />
<TabBar realm="forever" activa={tab} />

<div class="content-area">
  {tab === 'coaching' && <SeccionCoaching version="forever" />}
  {tab !== 'coaching' && visibles.map((t) => (
    <SeccionForever tab={t.id} label={t.label} pagina={paginas.get(t.id)} activa={t.id === tab}>
      {t.id === 'talentos' && (
        <>
          <CalculadoraTalentos />
          <h3>Rangos entrenables más altos a nivel 60</h3>
          <RangosEntrenables />
        </>
      )}
      {t.id === 'mascotas' && <MascotasForever />}
    </SeccionForever>
  ))}
</div>

<footer class="mk-footer">
  <div class="mk-footer__inner">
    <img src="/brand/mishuko-logo.webp" width="64" height="64" alt="" loading="lazy" />
    <div>
      <p class="mk-footer__meta">
        Creada y actualizada por <strong>Mishuko</strong>{lastUpdate && <> · <time datetime={lastUpdate}>{formatLong(lastUpdate)}</time></>}
      </p>
      <p class="mk-footer__note">
        Recurso de apoyo para entender la clase, escrito por Mishuko.
      </p>
      <nav class="mk-footer__links" aria-label="Otras guías">
        <a href="/">Inicio</a> · <a href="/midnight/">Guía Hunter BM Midnight</a>
      </nav>
    </div>
  </div>
</footer>
