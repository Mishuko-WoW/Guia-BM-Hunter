---
// Pestaña Mascotas de Midnight: mismo esquema que las de Forever. Contenido en midnight-mascotas.json → guide/MascotasMidnight.astro.
import SigueGuia from './SigueGuia.astro';
import EnResumen from './EnResumen.astro';
import Faq from './Faq.astro';
import MascotasMidnight from './guide/MascotasMidnight.astro';
import { getSectionReviewDate } from '../lib/sectionDates';

const reviewDate = getSectionReviewDate('mascotas', ['src/content/data/midnight-mascotas.json']);
---

<div id="tab-mascotas" class="tab-panel">
  <h2>Mejores mascotas del Hunter BM</h2>
  <EnResumen tab="mascotas" />
  <MascotasMidnight />
  <SigueGuia tab="mascotas" />
  <Faq tab="mascotas" titulo="mascotas" />
  {reviewDate && <p class="fv-review">Última revisión por <strong>Mishuko</strong> el <strong>{reviewDate}</strong>.</p>}
</div>
