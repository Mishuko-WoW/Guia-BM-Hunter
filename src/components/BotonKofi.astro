---
// Botón de apoyo en Ko-fi: footer de las guías, portada, menú móvil (TabBar) y, en pequeño, barra superior (RealmSwitch), con el aspecto del botón oficial de Ko-fi
// para que se reconozca: píldora naranja, taza blanca con corazón y texto blanco en negrita.
// Enlace propio con la taza en SVG: no se carga el widget externo de Ko-fi.
// Estilos: bloque "APOYO KO-FI" en marca.css (colores --kofi* en tokens.css). Evento GA4 «kofi_click».
interface Props {
  lugar: string;
  class?: string;
  /** Versión pequeña para la barra superior: «Apóyame» (en móvil solo la taza) */
  compacto?: boolean;
  /** Texto propio (p. ej. «Apóyame» en el menú móvil, donde comparte fila con RestedXP) */
  texto?: string;
}
const { lugar, class: extra, compacto = false, texto } = Astro.props;
---
<a
  class:list={['mk-kofi', { 'mk-kofi--mini': compacto }, extra]}
  aria-label={compacto ? 'Apóyame: invítame a un café en Ko-fi' : undefined}
  href="https://ko-fi.com/mishuko"
  target="_blank"
  rel="noopener"
  data-lugar={lugar}
  onclick="window.gtag&&gtag('event','kofi_click',{lugar:this.dataset.lugar})"
>
  <svg class="mk-kofi__taza" viewBox="0 0 32 24" width="30" height="22" aria-hidden="true" focusable="false">
    <path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h19A1.5 1.5 0 0 1 24 3.5V4h1.5a5.5 5.5 0 0 1 0 11H24a8 8 0 0 1-8 7H10a8 8 0 0 1-8-8z" fill="#fff" />
    <path d="M24 7.2h1.4a2.3 2.3 0 0 1 0 4.6H24z" fill="var(--kofi)" />
    <path d="M13 17.6l-4.3-4.2a2.6 2.6 0 0 1 3.7-3.7l.6.6.6-.6a2.6 2.6 0 0 1 3.7 3.7z" fill="var(--kofi-heart)" />
  </svg>
  <span>{texto ?? (compacto ? 'Apóyame' : 'Invítame a un café')}</span>
</a>
