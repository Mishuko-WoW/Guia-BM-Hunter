---
// Pestaña Stats de Midnight: mismo esquema que las de Forever. Contenido en midnight-estadisticas.json → guide/StatsMidnight.astro.
import SigueGuia from './SigueGuia.astro';
import EnResumen from './EnResumen.astro';
import Faq from './Faq.astro';
import StatsMidnight from './guide/StatsMidnight.astro';
import { getSectionReviewDate } from '../lib/sectionDates';

const reviewDate = getSectionReviewDate('estadisticas', ['src/content/data/midnight-estadisticas.json']);
---

<div id="tab-estadisticas" class="tab-panel">
  <h2>Estadísticas del Hunter BM (Maestro de bestias)</h2>
  <EnResumen tab="estadisticas" />
  <StatsMidnight />
  <SigueGuia tab="estadisticas" />
  <Faq tab="estadisticas" titulo="estadísticas" />
  {reviewDate && <p class="fv-review">Última revisión por <strong>Mishuko</strong> el <strong>{reviewDate}</strong>.</p>}
</div>
