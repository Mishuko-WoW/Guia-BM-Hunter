---
// Pestaña General de Midnight: mismo esquema que las de Forever (SeccionForever.astro).
// Contenido en src/content/data/midnight-general.json → guide/GeneralMidnight.astro.
import SigueGuia from './SigueGuia.astro';
import EnResumen from './EnResumen.astro';
import Faq from './Faq.astro';
import GeneralMidnight from './guide/GeneralMidnight.astro';
import { getSectionReviewDate } from '../lib/sectionDates';

const reviewDate = getSectionReviewDate('mecanicas', ['src/content/data/midnight-general.json']);
---

<div id="tab-mecanicas" class="tab-panel active">
  <h2>Visión general del Hunter BM (Maestro de bestias)</h2>
  <EnResumen tab="mecanicas" />
  <GeneralMidnight />
  <SigueGuia tab="mecanicas" />
  <Faq tab="mecanicas" titulo="Hunter BM en Midnight" />
  {reviewDate && <p class="fv-review">Última revisión por <strong>Mishuko</strong> el <strong>{reviewDate}</strong>.</p>}
</div>
