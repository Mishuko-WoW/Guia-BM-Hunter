---
// Guía de Midnight: cabecera, pestañas y SOLO la sección de la página actual (una página por pestaña).
// "rotacion" incluye también "opener" (se cambia con el selector de dentro) y "mecanicas" la sección
// oculta "errores" (reservada al coaching).
import Header from '../Header.astro';
import TabBar from '../TabBar.astro';
import SeccionMecanicas from '../SeccionMecanicas.astro';
import SeccionTalentos from '../SeccionTalentos.astro';
import SeccionSimulacion from '../SeccionSimulacion.astro';
import SeccionStats from '../SeccionStats.astro';
import SeccionRotacion from '../SeccionRotacion.astro';
import SeccionOpener from '../SeccionOpener.astro';
import SeccionBiS from '../SeccionBiS.astro';
import SeccionMacros from '../SeccionMacros.astro';
import SeccionMascotas from '../SeccionMascotas.astro';
import SeccionErrores from '../SeccionErrores.astro';
import SeccionCoaching from '../SeccionCoaching.astro';
import { formatLong, latestChangeDate } from '../../lib/changelog';
import { SEO } from '../../lib/seo';

interface Props {
  tab?: string;
}
const { tab = 'mecanicas' } = Astro.props;

// Fecha del footer = último cambio anotado en changelog.json
const lastUpdate = latestChangeDate();
---

<Header realm="midnight" subtitulo={SEO.midnight[tab]?.h1sub} />
<TabBar realm="midnight" activa={tab} />

<div class="content-area">
  {tab === 'mecanicas' && <><SeccionMecanicas /><SeccionErrores /></>}
  {tab === 'talentos' && <SeccionTalentos />}
  {tab === 'simulacion' && <SeccionSimulacion />}
  {tab === 'estadisticas' && <SeccionStats />}
  {tab === 'rotacion' && <><SeccionRotacion /><SeccionOpener /></>}
  {tab === 'bis' && <SeccionBiS />}
  {tab === 'macros' && <SeccionMacros />}
  {tab === 'mascotas' && <SeccionMascotas />}
  {tab === 'coaching' && <SeccionCoaching />}
</div>

<footer class="mk-footer">
  <div class="mk-footer__inner">
    <img src="/brand/mishuko-logo.webp" width="64" height="64" alt="" loading="lazy" />
    <div>
      <p class="mk-footer__meta">
        Creada y actualizada por <strong>Mishuko</strong>{lastUpdate && <> · <time datetime={lastUpdate}>{formatLong(lastUpdate)}</time></>}
      </p>
      <p class="mk-footer__note">
        Recurso de apoyo para entender la clase. Basado en Wowhead, Icy Veins, WarcraftLogs y mi experiencia personal.
      </p>
      <nav class="mk-footer__links" aria-label="Otras guías">
        <a href="/">Inicio</a> · <a href="/forever/">Guía Hunter WoW Forever</a>
      </nav>
    </div>
  </div>
</footer>
