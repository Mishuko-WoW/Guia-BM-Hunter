---
// Pestaña Stats (Midnight) con el mismo diseño que Stats de Forever (clases lv-*/gn-*/st-rank de forever.css).
// Contenido: src/content/data/midnight-estadisticas.json.
import data from '../../content/data/midnight-estadisticas.json';
import { getSpell, iconUrl } from '../../lib/spells';
import { md, mentionedSpells } from '../../lib/markup';
import IndiceForever from '../forever/IndiceForever.astro';

const faltan = [...new Set(mentionedSpells(JSON.stringify({ ...data, _ayuda: '' })))].filter((n) => !getSpell(n));
if (faltan.length) throw new Error(`midnight-estadisticas.json: hechizos que no están en spells.json: ${faltan.join(', ')}`);

const INDICE = [
  { id: 'sm-st', texto: 'Un objetivo' },
  { id: 'sm-aoe', texto: 'AoE' },
  { id: 'sm-valor', texto: 'Qué aporta cada una' },
  { id: 'sm-dr', texto: 'Rendimientos decrecientes' },
];
const LISTAS = [
  { id: 'sm-st', titulo: 'Prioridad en un objetivo (Single-Target)', lista: data.st },
  { id: 'sm-aoe', titulo: 'Prioridad en AoE', lista: data.aoe },
];
---

<div class="lv gn st">
  <div class="gn-hero">
    <p set:html={md(data.resumen)} />
    <ul class="gn-datos">
      {data.datos.map((d) => <li><b>{d.valor}</b><span>{d.texto}</span></li>)}
    </ul>
  </div>

  <IndiceForever items={INDICE} />

  {LISTAS.map((l) => (
    <section class="lv-sec" id={l.id}>
      <h3>{l.titulo}</h3>
      <p class="lv-lead">De más a menos importante. Sirve igual para Pack Leader y Dark Ranger.</p>
      <ol class="st-rank">
        {l.lista.map((s, i) => (
          <li class={`st-rank__item st-rank__item--${i < 2 ? 'top' : i < 4 ? 'alta' : 'baja'}`}>
            <span class="st-rank__n">{i + 1}</span>
            <img src={iconUrl(s.icono)} alt="" width="48" height="48" loading="lazy" />
            <div>
              <h4>{s.nombre} <span class:list={['gn-tag', { 'is-new': i < 2 }]}>{s.etiqueta}</span></h4>
              <p set:html={md(s.texto)} />
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <section class="lv-sec" id="sm-valor">
    <h3>Qué aporta cada estadística secundaria</h3>
    <div class="lv-table-wrap">
      <table class="lv-table lv-table--objetos">
        <thead><tr><th>Estadística</th><th>Para qué sirve</th></tr></thead>
        <tbody>{data.valor.map((v) => <tr><td><b>{v.stat}</b></td><td set:html={md(v.nota)} /></tr>)}</tbody>
      </table>
    </div>
    <div class="box box-tip">
      <div class="box-title">Simula siempre</div>
      <span set:html={md(data.simula)} />
    </div>
  </section>

  <section class="lv-sec" id="sm-dr">
    <h3>Rendimientos decrecientes</h3>
    <p class="lv-lead" set:html={md(data.rendimientos.intro)} />
    <div class="lv-table-wrap">
      <table class="lv-table lv-table--objetos">
        <thead><tr><th>Estadística</th><th>Rinde menos a partir de</th></tr></thead>
        <tbody>{data.rendimientos.filas.map((f) => <tr><td><b>{f.stat}</b></td><td>{f.rating} de rating</td></tr>)}</tbody>
      </table>
    </div>
    <p class="lv-lead" set:html={md(data.rendimientos.nota)} />
  </section>
</div>
