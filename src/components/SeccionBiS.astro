---
// Pestaña BiS de Midnight: mismo diseño que el BiS de Forever. Datos en src/content/data/midnight-bis.json → guide/BisMidnight.astro.
import SigueGuia from './SigueGuia.astro';
import EnResumen from './EnResumen.astro';
import Faq from './Faq.astro';
import BisMidnight from './guide/BisMidnight.astro';
import { getSectionReviewDate } from '../lib/sectionDates';

const reviewDate = getSectionReviewDate('bis', ['src/content/data/midnight-bis.json']);
---


<div class="tab-panel" id="tab-bis">
  <h2>BiS y estadísticas del Hunter BM: equipo y consumibles</h2>
  <EnResumen tab="bis" />
  <BisMidnight />
  <SigueGuia tab="bis" />
  <Faq tab="bis" titulo="BiS y trinkets" />
  {reviewDate && <p class="fv-review">Última revisión por <strong>Mishuko</strong> el <strong>{reviewDate}</strong>.</p>}
</div>
