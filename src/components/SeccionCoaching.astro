---
// Página de Coaching. La misma para Midnight y Forever: solo cambian los textos de TEXTOS[version].
interface Props {
  version?: 'midnight' | 'forever';
}
const { version = 'midnight' } = Astro.props;

const TEXTOS = {
  midnight: {
    contexto: null,
    consiste: 'Te ofrezco ayuda directa y personalizada para mejorar tu Hunter Beast Mastery en Midnight. Cada sesion esta adaptada a tu nivel actual y objetivos.',
    incluye: [
      'Analisis detallado de tus logs (Warcraft Logs)',
      'Revision de tus simulaciones en Raidbots',
      'Correccion de opener, rotacion y prioridades',
      'Optimizacion de talentos por raid / boss / Mythic+',
      'Consejos especificos sobre equipo, mascotas y consumibles',
      'Resolucion de errores comunes y malos habitos',
      'Plan de mejora personalizado',
    ],
    individual: [
      'Sims premium (Quick Sim + Top Gear + Optimizer)',
      'Revisión previa completa de logs',
      'Sesión privada en Discord',
      'Feedback detallado en vivo',
      'Plan personalizado post-sesión',
    ],
    pro: [
      'Sesión privada cada semana (1 hora aprox)',
      'Análisis completo de logs semanales',
      'Simulaciones premium semanales',
      'Revisión de decisiones de Vault',
      'Revisión de vídeos Archon grabados (si los aportas)',
      'Plan progresivo adaptado a ti',
    ],
    cierre: '¿Listo para topear aunque nuestra clase de pena?',
  },
  forever: {
    contexto: 'Ahora aplico esa misma forma de trabajar a WoW Forever: la guía del Cazador de Bestias para Forever sigue el mismo método, basado en datos y probado en juego.',
    consiste: 'Te ofrezco ayuda directa y personalizada para mejorar tu Cazador de Bestias (Hunter BM) en WoW Forever, tanto si estás subiendo de nivel como si ya juegas mazmorras y banda a nivel 60. Cada sesión está adaptada a tu nivel actual y a tus objetivos.',
    incluye: [
      'Revisión de tu rotación: Tiro automático, Invocar halcón y gestión del maná',
      'Elección y entrenamiento de tu mascota: familia, habilidades y rangos',
      'Talentos para raid, mazmorras o leveling, según lo que juegues',
      'Ruta de leveling, profesiones y qué entrenar en cada nivel',
      'Equipo, consumibles y prioridad de estadísticas',
      'Análisis de tus registros de combate si los tienes (Warcraft Logs)',
      'Plan de mejora personalizado',
    ],
    individual: [
      'Revisión previa de tu personaje, talentos y equipo',
      'Revisión de logs o vídeos de tus combates (si los aportas)',
      'Sesión privada en Discord',
      'Feedback detallado en vivo',
      'Plan personalizado post-sesión',
    ],
    pro: [
      'Sesión privada cada semana (1 hora aprox)',
      'Seguimiento semanal de tu progreso (leveling, mazmorras o banda)',
      'Revisión semanal de equipo, talentos y mascota',
      'Revisión de logs semanales (si juegas contenido con registros)',
      'Revisión de vídeos grabados de tus combates (si los aportas)',
      'Plan progresivo adaptado a ti',
    ],
    cierre: '¿Listo para llevar a tu Cazador al siguiente nivel?',
  },
}[version];
---

<div id="tab-coaching" class="tab-panel">
  <main class="coach-container">

    <header class="header">
      <h1 style="font-size:26px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--accent-gold);margin-bottom:0.5rem">Coaching Personalizado para tu BM</h1>
      <p style="font-size: 1.3rem; font-weight: 700; color: var(--text-primary);">Pasa de leer la guia a dominar tu Hunter de verdad.</p>
    </header>

    <div class="coach-two-column">
      <section class="coach-card accent-gold">
        <div class="coach-tag gold">Importante</div>
        <h2>La guia siempre sera 100% gratuita</h2>
        <p>
          Toda la informacion (rotaciones, talentos, simulacion, analisis de logs, etc.) seguira siendo publica y gratuita para cualquiera que quiera aprender.
          El coaching es solo para quienes quieren <strong>ayuda personalizada</strong> para aplicar todo ese conocimiento en su propio personaje.
        </p>
      </section>

      <section class="coach-card">
        <h2>¿Quién soy yo para enseñarte a jugar y por qué creé esta guía?</h2>
        <p style="font-size: 1.08rem; line-height: 1.75;">
          Soy un jugador de Hunter Beast Mastery obsesionado con los datos y métricas, de esos que despues de raid pasan horas mirando y analizando logs para mejorar mi rendimiento la semana que viene. Tras raidear mítico en <strong>The War Within</strong> manteniendo parses altos de forma consistente, empecé creando guías internas para mis compañeros de guild.
        </p>
        <br>
        <p>
          Eso me llevó a desarrollar esta guía completa: un recurso grande, profundo y bien estructurado que reúne <strong>todo lo que un jugador de Hunter BM necesita</strong> en un solo sitio: rotaciones, talentos por boss, simulaciones, análisis de logs, macros, mascotas, errores comunes y más. Y claro está <strong>actualizado siempre</strong> a lo último que tengamos ingame.
        </p>
        <br>
        <p style="margin-bottom: 0;">
          Mi objetivo principal es que sea la referencia práctica que yo mismo querría tener abierta en segunda pantalla mientras juego: clara, actualizada y basada en datos reales, para que puedas resolver cualquier duda rápidamente sin tener que saltar entre varias webs.
        </p>
        {TEXTOS.contexto && <><br><p style="margin-bottom: 0;">{TEXTOS.contexto}</p></>}
      </section>
    </div>

    <section class="coach-card">
      <h2>En que consiste el coaching?</h2>
      <p>{TEXTOS.consiste}</p>

      <div class="coach-grid even">
        <div>
          <h3>Que incluye una sesion tipica:</h3>
          <ul class="coach-bullets">
            {TEXTOS.incluye.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div>
          <div class="coach-showcase">
            <img class="coach-showcase-image" src="https://i.imgur.com/urm8f5M.png" alt="Ejemplo de analisis de logs" role="button" tabindex="0" aria-label="Abrir imagen en grande" />
            <div class="coach-caption">Ejemplo de revision detallada de logs y simulaciones</div>
          </div>
        </div>
      </div>
    </section>

    <div id="coachLightbox" class="coach-lightbox" aria-hidden="true">
      <button id="coachLightboxClose" class="coach-lightbox-close" type="button" aria-label="Cerrar imagen">x</button>
      <img id="coachLightboxImage" class="coach-lightbox-image" alt="Vista ampliada" />
    </div>

    <section class="coach-card accent-cyan">
      <h2>Opciones de Coaching y Apoyo</h2>
      

      <div class="coach-pricing-grid">

        <!-- 1. Mensaje de feedback -->
        <article class="coach-tier support">
          <h3>💬 ¿Te ha servido la guía?</h3>
          <p class="tier-subtitle">Hazme saber si la guía te ha ayudado</p>
          <ul class="coach-check-list">
            <li><span class="ok">✓</span> Si la guía te ha servido, ¡me alegrarás el día escribiéndome un mensaje!</li>
            <li><span class="ok">✓</span> Puedes contarme tu experiencia, sugerencias o simplemente saludar</li>
          </ul>
          <a href="https://discordapp.com/users/604762837092532233" target="_blank" rel="noopener noreferrer" class="coach-btn">Escríbeme por Discord</a>
        </article>

        <!-- 2. Coaching Individual -->
        <article class="coach-tier">
          <h3>🎯 Sesión Individual</h3>
          <p class="tier-subtitle">Revisión profunda personalizada de tu personaje</p>
          <p class="price cyan">Consulta el precio conmigo en Discord</p>
          <p style="font-size: 13px; color: var(--text2); margin-bottom: 1rem;">1 hora aprox · 1:1 privado</p>
          <ul class="coach-check-list">
            {TEXTOS.individual.map((t) => <li><span class="ok">✓</span> {t}</li>)}
          </ul>
          <p class="small-note">💡 <strong>Para ti si:</strong> quieres una revisión profunda y puntual</p>
          <a href="https://discordapp.com/users/604762837092532233" target="_blank" rel="noopener noreferrer" class="coach-btn">Contactar</a>
        </article>

        <!-- 3. Coaching Pro -->
        <article class="coach-tier premium">
          <div class="tier-badge popular">⭐ POPULAR</div>
          <h3>⚡ Coaching Pro</h3>
          <p class="tier-subtitle">Seguimiento con mejora consistente</p>
          <p class="price cyan">Consulta el precio conmigo en Discord</p>
          <p style="font-size: 13px; color: var(--text2); margin-bottom: 1rem;">4 semanas · 4 sesiones incluidas</p>
          <ul class="coach-check-list">
            {TEXTOS.pro.map((t) => <li><span class="ok">✓</span> {t}</li>)}
          </ul>
          <p class="small-note">🚀 <strong>Para ti si:</strong> buscas transformación real con seguimiento</p>
          <a href="https://discordapp.com/users/604762837092532233" target="_blank" rel="noopener noreferrer" class="coach-btn primary">Reservar</a>
        </article>

      </div>
    </section>

    <section class="coach-card accent-gold center">
      <h2 style="margin-bottom: 1rem;">{TEXTOS.cierre}</h2>
      <p style="font-size: 1.05rem; margin-bottom: 2rem;">La guía es gratuita. El coaching es la inversión en TI.</p>

      <div class="coach-cta-options">
        <a href="https://discordapp.com/users/604762837092532233" target="_blank" rel="noopener noreferrer" class="coach-btn primary large">
          📩 Hablar por Discord
        </a>
        <p style="color: var(--text3); font-size: 14px; margin: 1rem 0;">O elige tu opción arriba en "Opciones de Coaching y Apoyo"</p>
      </div>
    </section>

    <section class="coach-bottom-cta">
      <div>
        <h3>✨ Gracias por leer la guía</h3>
        <p>Tu apoyo (sea cual sea) es lo que me permite seguir creando contenido de calidad, actualizado cada parche, y ayudando a la comunidad a mejorar.</p>
      </div>
    </section>

  </main>
</div>

<style>
  #tab-coaching {
    --accent-gold: var(--pl);
    --text-primary: var(--text);
    --text-secondary: var(--text2);
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
      --coach-showcase-img-width: 100%;
      --coach-showcase-img-max-width: 100%;
    --coach-showcase-img-height: auto;
    --coach-showcase-img-object-fit: contain;
      --coach-showcase-img-left-bias: 0;
    --coach-showcase-column-padding-left: 0.7rem;
    --coach-grid-text-fr: 0.7fr;
    --coach-grid-image-fr: 1.3fr;
    font-family: var(--font-sans);
  }

  .header { text-align: center; margin-bottom: 3rem; }
  .header h1 { font-size: 2.5rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em; margin-bottom: 1rem; line-height: 1.2; }
  .header h1 span { color: var(--accent-cyan); }
  .header p { color: var(--text-secondary); font-size: 1.1rem; max-width: 600px; margin: 0 auto; }

  .coach-container { max-width: 1280px; margin: 0 auto; padding: 0; }

  .coach-two-column { display: grid; gap: 1.8rem; margin-bottom: 2rem; grid-template-columns: 1fr; }
  .coach-card.accent-gold { 
    border-color: color-mix(in srgb, var(--pl) 35%, transparent);
    background: linear-gradient(135deg, var(--bg3) 0%, color-mix(in srgb, var(--pl) 3%, transparent) 100%);
    border-left: 6px solid var(--pl);
  }
  .coach-card.accent-cyan { border-color: color-mix(in srgb, var(--accent) 25%, transparent); }
  .coach-card.center { text-align: center; }

  .coach-card {
    background: var(--bg2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.7rem;
    margin-bottom: 1.5rem;
  }

  .coach-tag {
    display: inline-flex;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 1rem;
  }
  .coach-tag.gold { background: color-mix(in srgb, var(--pl) 15%, transparent); color: var(--pl); border: 1px solid color-mix(in srgb, var(--pl) 22%, transparent); }

  .coach-card h2 { font-size: 1.62rem; margin-bottom: 0.65rem; color: var(--text); }
  .coach-card h3 { font-size: 1.14rem; margin-bottom: 0.45rem; }
  .coach-card p { color: var(--text2); line-height: 1.66; font-size: 15.8px; }
  .coach-card strong { color: var(--text); }

  .coach-grid { display: grid; gap: 1.75rem; margin-top: 1.5rem; }
  .coach-grid.even { grid-template-columns: 1fr; }
    .coach-grid.even > div { min-width: 0; }
  @media (min-width: 900px) {
      .coach-grid.even { grid-template-columns: minmax(0, var(--coach-grid-text-fr)) minmax(0, var(--coach-grid-image-fr)); }
    .coach-grid.even > div:last-child { padding-left: var(--coach-showcase-column-padding-left); }
  }

  .coach-bullets { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; margin: 0; padding: 0; }
  .coach-bullets li { position: relative; padding-left: 1.2rem; color: var(--text2); font-size: 15.8px; }
  .coach-bullets li::before { content: "•"; position: absolute; left: 0; color: var(--accent); font-weight: 700; }

  .coach-showcase { border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; overflow: hidden; width: 100%; max-width: 100%; transform: none; }
  .coach-showcase-image {
    width: 100%;
    max-width: 100%;
    height: var(--coach-showcase-img-height);
    object-fit: var(--coach-showcase-img-object-fit);
    display: block;
    margin: 0;
    cursor: zoom-in;
  }
  .coach-caption { font-size: 13px; color: var(--text3); text-align: center; padding: 0.7rem 0.9rem; background: var(--bg3); }

  .coach-lightbox {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .coach-lightbox.is-open { display: flex; }
  .coach-lightbox-image {
    max-width: 95vw;
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: 0;
    border: 0;
    box-shadow: none;
  }
  .coach-lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: auto;
    height: auto;
    border-radius: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
    padding: 0.15rem 0.35rem;
    cursor: pointer;
  }

  .coach-pricing-grid { display: grid; gap: 1.5rem; margin-top: 2rem; grid-template-columns: 1fr; }
  @media (min-width: 900px) {
    .coach-pricing-grid { grid-template-columns: 1fr 1fr 1fr; }
  }

  .coach-tier {
    background: var(--bg3);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.8rem;
    position: relative;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }
  
  .coach-tier:hover {
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }
  
  .coach-tier.support { border-color: color-mix(in srgb, var(--pl) 20%, transparent); }
  .coach-tier.support:hover { border-color: color-mix(in srgb, var(--pl) 35%, transparent); }
  
  .coach-tier.premium { 
    border: 2px solid color-mix(in srgb, var(--accent) 50%, transparent); 
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 8%, transparent) 0%, color-mix(in srgb, var(--accent) 6%, transparent) 50%, color-mix(in srgb, var(--pl) 2%, transparent) 100%);
    box-shadow: 0 0 20px color-mix(in srgb, var(--accent) 15%, transparent), inset 0 0 20px color-mix(in srgb, var(--accent) 2%, transparent);
  }
  .coach-tier.premium:hover { 
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
    box-shadow: 0 0 30px color-mix(in srgb, var(--accent) 25%, transparent), inset 0 0 20px color-mix(in srgb, var(--accent) 3%, transparent);
    transform: translateY(-6px);
  }
  
  .tier-badge {
    position: absolute;
    top: -12px;
    right: 16px;
    padding: 4px 16px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: var(--text);
  }
  
  .coach-tier h3 { margin: 0 0 0.5rem; color: var(--text); font-size: 1.35rem; }
  .tier-subtitle { margin: 0 0 1rem; font-size: 13px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.05em; }
  
  .price { 
    margin: 1rem 0 0.5rem; 
    font-size: 1.65rem; 
    font-weight: 700;
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: 12px;
    border: 1px solid;
    letter-spacing: 0.02em;
  }
  .price.cyan { 
    color: var(--accent); 
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .price.amber { 
    color: var(--pl); 
    background: color-mix(in srgb, var(--pl) 12%, transparent);
    border-color: color-mix(in srgb, var(--pl) 30%, transparent);
  }

  .coach-check-list { list-style: none; margin: 1.5rem 0; padding: 0; display: flex; flex-direction: column; gap: 0.65rem; flex-grow: 1; }
  .coach-check-list li { color: var(--text2); font-size: 14px; display: flex; align-items: flex-start; gap: 0.6rem; line-height: 1.5; }
  .coach-check-list .ok { color: var(--green); font-weight: 700; flex-shrink: 0; }
  .small-note { margin-top: 1.5rem; margin-bottom: 1rem; font-size: 12px; color: var(--text3); }
  
  .coach-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-weight: 700;
    color: var(--bg);
    background: var(--pl);
    border: 1px solid color-mix(in srgb, var(--pl) 40%, transparent);
    border-radius: 999px;
    font-size: 14px;
    padding: 0.75rem 1.5rem;
    transition: all 0.2s ease;
    margin-top: auto;
  }
  
  .coach-btn:hover {
    background: #fbbf24;
    box-shadow: 0 8px 20px color-mix(in srgb, var(--pl) 30%, transparent);
    transform: translateY(-2px);
  }
  
  .coach-btn.small {
    font-size: 13px;
    padding: 0.65rem 1.2rem;
  }
  
  .coach-btn.primary {
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  
  .coach-btn.primary:hover {
    background: linear-gradient(135deg, var(--accent2), var(--accent));
    box-shadow: 0 8px 20px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .coach-btn.large {
    font-size: 16px;
    padding: 1rem 2rem;
  }
  
  .coach-cta-wrap { margin-top: 1.5rem; }
  .coach-cta-options { margin-top: 2rem; }
  .coach-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-weight: 700;
    color: var(--bg);
    background: var(--pl);
    border: 1px solid color-mix(in srgb, var(--pl) 40%, transparent);
    border-radius: 999px;
    font-size: 14.9px;
    padding: 0.82rem 1.52rem;
  }

  .coach-bottom-cta {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, transparent), color-mix(in srgb, var(--pl) 12%, transparent));
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 2rem 1.8rem;
  }
  .coach-bottom-cta h3 { margin: 0 0 0.5rem; color: var(--text); font-size: 1.3rem; font-weight: 700; }
  .coach-bottom-cta p { margin: 0; color: var(--text2); font-size: 15px; line-height: 1.6; }
  @media (min-width: 900px) {
    .coach-bottom-cta { flex-direction: row; align-items: center; justify-content: space-between; }
  }
</style>

<script>
  const sourceImage = document.querySelector<HTMLImageElement>('#tab-coaching .coach-showcase-image');
  const lightbox = document.getElementById('coachLightbox');
  const lightboxImage = document.getElementById('coachLightboxImage') as HTMLImageElement | null;
  const lightboxClose = document.getElementById('coachLightboxClose');

  const openLightbox = () => {
    if (!sourceImage || !lightbox || !lightboxImage) return;
    lightboxImage.src = sourceImage.src;
    lightboxImage.alt = sourceImage.alt;
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  if (sourceImage) {
    sourceImage.addEventListener('click', openLightbox);
    sourceImage.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openLightbox();
      }
    });
  }

  if (lightboxClose) {
    lightboxClose.addEventListener('click', closeLightbox);
  }

  if (lightbox) {
    lightbox.addEventListener('click', (event: MouseEvent) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    });
  }

  document.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape' && lightbox && lightbox.classList.contains('is-open')) {
      closeLightbox();
    }
  });
</script>