---
// Pestaña Macros de Midnight: mismo diseño que Macros de Forever (forever/MacrosForever.astro con realm="midnight").
// Contenido: src/content/data/midnight-macros.json.
import EnResumen from './EnResumen.astro';
import Faq from './Faq.astro';
import SigueGuia from './SigueGuia.astro';
import MacrosForever from './forever/MacrosForever.astro';
import data from '../content/data/midnight-macros.json';
import { getSectionReviewDate } from '../lib/sectionDates';

const reviewDate = getSectionReviewDate('macros', ['src/content/data/midnight-macros.json']);
---

<div id="tab-macros" class="tab-panel">
  <h2>Macros recomendadas para Hunter BM</h2>
  <EnResumen tab="macros" />
  <MacrosForever data={data} realm="midnight" />
  <SigueGuia tab="macros" />
  <Faq tab="macros" titulo="macros" />
  {reviewDate && <p class="fv-review">Última revisión por <strong>Mishuko</strong> el <strong>{reviewDate}</strong>.</p>}
</div>
