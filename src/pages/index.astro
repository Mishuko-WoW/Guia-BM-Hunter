---
// Portada: elección entre Midnight y Forever
import MainLayout from '../layouts/MainLayout.astro';
import { REALMS } from '../lib/realms';
import { PORTADA, PORTADA_JSONLD, tabPath } from '../lib/seo';
import { TABS_MIDNIGHT } from '../lib/tabs';
import '../styles/portada.css';

// Enlaces antiguos guiahunterbm.com/#<pestaña> → su página de Midnight (sin pasar por un 404)
const RUTAS_MIDNIGHT = Object.fromEntries(TABS_MIDNIGHT.map((t) => [t.id, tabPath('midnight', t.id)]));
---

<MainLayout
  realm="portada"
  title={PORTADA.title}
  description={PORTADA.description}
  jsonLd={PORTADA_JSONLD}
>
  <!-- Enlaces antiguos (guiahunterbm.com/#bis…) → la página de esa pestaña en Midnight -->
  <script is:inline define:vars={{ RUTAS_MIDNIGHT }}>
    const toGuide = () => {
      const h = location.hash.slice(1);
      if (!h) return;
      // pestaña conocida → su página; cualquier otro # (alias antiguos) → la guía, que lo resuelve
      location.replace(RUTAS_MIDNIGHT[h] || '/midnight/' + location.hash);
    };
    toGuide();
    addEventListener('hashchange', toGuide);
  </script>

  <main class="pt">
    <div class="pt-bg" aria-hidden="true">
      <span class="pt-glow pt-glow--midnight"></span>
      <span class="pt-glow pt-glow--forever"></span>
      <span class="pt-grid"></span>
    </div>

    <header class="pt-head">
      <img class="pt-logo" src="/brand/mishuko-logo.webp" width="150" height="150" alt="Logo de Mishuko" fetchpriority="high" />
      <h1 class="pt-eyebrow">Guía Hunter <b>BM</b> <i>·</i> Cazador de Bestias <i>·</i> por Mishuko</h1>
      <p class="pt-title">Elige tu <span>versión</span></p>
    </header>

    <div class="pt-cards">
      {REALMS.map((r, i) => (
        <a class:list={['pt-card', `pt-card--${r.id}`]} href={r.href} style={`--d:${i}`} data-tilt>
          <span class="pt-card__shine" aria-hidden="true"></span>
          {r.etiqueta && <span class="pt-card__tag">{r.etiqueta}</span>}
          <span class="pt-card__logo">
            {r.logo ? <img src={r.logo} alt={`World of Warcraft ${r.nombre}`} /> : (
              <span class="pt-card__wordmark">
                <small>World of Warcraft</small>
                {r.titulo}
              </span>
            )}
          </span>
          <span class="pt-card__sub">{r.subtitulo}</span>
          <span class="pt-card__status">
            {r.estado ?? (r.disponible ? 'Guía completa: talentos, rotación, opener y BiS' : 'En construcción · disponible en menos de 24 h')}
          </span>
          <span class="pt-card__cta">
            {r.disponible ? 'Entrar a la guía' : 'Ver avance'}
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" /></svg>
          </span>
        </a>
      ))}
      <span class="pt-divider" aria-hidden="true"><i></i></span>
    </div>

    <section class="pt-about" aria-label="Sobre la guía">
      <p>
        Guías en español del <strong>Hunter BM</strong> (<strong>Cazador de Bestias</strong>) escritas por Mishuko:
        la <a href="/midnight/">guía Hunter BM de Midnight</a> (Temporada 2: talentos, rotación, opener y BiS) y la
        <a href="/forever/">guía Hunter de WoW Forever</a> (talentos 31/20/0, <a href="/forever/mascotas/">mascotas</a> y leveling).
      </p>
    </section>

    <footer class="pt-foot">Guía de apoyo creada por <strong>Mishuko</strong> · guiahunterbm.com</footer>
  </main>

  <script is:inline>
    // Inclinación 3D suave de las tarjetas siguiendo el ratón
    if (matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
      document.querySelectorAll('[data-tilt]').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          card.style.setProperty('--rx', `${(-y * 7).toFixed(2)}deg`);
          card.style.setProperty('--ry', `${(x * 9).toFixed(2)}deg`);
          card.style.setProperty('--mx', `${((x + 0.5) * 100).toFixed(1)}%`);
          card.style.setProperty('--my', `${((y + 0.5) * 100).toFixed(1)}%`);
        });
        card.addEventListener('pointerleave', () => {
          card.style.setProperty('--rx', '0deg');
          card.style.setProperty('--ry', '0deg');
        });
      });
    }
  </script>
</MainLayout>
