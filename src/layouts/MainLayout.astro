---
// Orden: tokens de marca → estilos heredados → capa de marca (gana)
import '../styles/tokens.css';
import '../styles/bm-guide.css';
import '../styles/marca.css';
import Particulas from '../components/Particulas.astro';
import { OG } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Versión de la web: cambia el tema (data-realm) y el grupo de contenido de Analytics */
  realm?: 'portada' | 'midnight' | 'forever';
  /** Pestaña de esta página (cada pestaña es una página; Analytics y bm-guide.js la usan) */
  defaultTab?: string;
  /** true = no indexar (pestañas "en preparación") */
  noindex?: boolean;
  /** Datos estructurados (JSON-LD) de la página */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = 'Guía Hunter BM — Midnight S2',
  description = 'Guía del Cazador de Bestias (Hunter BM) en WoW Midnight Temporada 2.',
  realm = 'midnight',
  defaultTab = '',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const og = OG[realm];
const ogImage = new URL(og.image, Astro.site).href;
---

<html lang="es" data-realm={realm} data-default-tab={defaultTab}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Vista previa al compartir (Discord, redes sociales) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Guía Hunter BM" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0a0d09" />

    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/icon-192.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="preload" as="image" href="/brand/mishuko-logo.webp" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,500;0,600;0,700;0,800;1,700&family=Barlow:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EJY55YHE6Q"></script>

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-EJY55YHE6Q', {
    send_page_view: false
  });

  // Ruta limpia para GA4: /<versión>/<pestaña> (igual que antes de tener una página por pestaña):
  // /midnight/talentos/ → /midnight/talentos · /midnight/rotacion/#opener → /midnight/opener · /midnight/ → /midnight/mecanicas
  // Agrupamos por versión (content_group: portada | midnight | forever)
  function trackPageView() {
    const root = document.documentElement;
    const realmBase = root.dataset.realm === 'portada' ? '' : '/' + root.dataset.realm;
    const hash = location.hash.slice(1);
    const esPestana = /^[a-z-]+$/.test(hash) && document.querySelector('.mk-tab[data-tab="' + hash + '"]');
    const tab = (esPestana ? hash : '') || root.dataset.defaultTab || '';
    const pagePath = (realmBase + (tab ? '/' + tab : '')) || '/';
    gtag('event', 'page_view', {
      page_path: pagePath,
      page_location: location.origin + pagePath,
      page_title: document.title + (tab ? ' - ' + tab : ''),
      content_group: root.dataset.realm,
    });
  }

  window.addEventListener('load', trackPageView);
  window.addEventListener('hashchange', trackPageView);
</script>
  </head>

  <body>
    <Particulas />
    <slot />
  </body>
</html>