---
// Orden: tokens de marca → estilos heredados → capa de marca (gana)
import '../styles/tokens.css';
import '../styles/bm-guide.css';
import '../styles/marca.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Guía Hunter BM — Midnight S2',
  description = 'Mejores talentos, rotación y equipo BiS para Hunter BM en Midnight Season 2. ¡Guía PvE 100% actualizada!.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/brand/og-image.png', Astro.site).href;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Vista previa al compartir (Discord, redes sociales) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Guía Hunter BM" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Guía Hunter BM de Mishuko — Midnight Temporada 2" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0a0d09" />

    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/icon-192.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="preload" as="image" href="/brand/mishuko-logo.webp" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,500;0,600;0,700;0,800;1,700&family=Barlow:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "Guía Hunter BM: Talentos, Rotación y Builds PvE",
      "description": "Guía completa de Beast Mastery Hunter para PvE en World of Warcraft: Midnight. Incluye mecánicas, rotación, talentos héroe, procs clave, BiS y gestión de mascotas.",
      "inLanguage": "es",
      "author": {
        "@type": "Organization",
        "name": "Mishuko"
      },
      "about": [
        "Beast Mastery Hunter",
        "Hunter BM PvE",
        "World of Warcraft Midnight"
      ]
    }
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EJY55YHE6Q"></script>

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-EJY55YHE6Q', {
    send_page_view: false
  });

  function trackHashChange() {
    const hash = window.location.hash || '#mecanicas';
    // Limpiamos el # para que sea una ruta normal
    const pagePath = hash.replace('#', '/');
    
    gtag('event', 'page_view', {
      page_path: pagePath,
      page_location: window.location.href,
      page_title: document.title + ' - ' + hash.replace('#', '')
    });
  }

  window.addEventListener('load', trackHashChange);
  window.addEventListener('hashchange', trackHashChange);
</script>
  </head>

  <body>
    <slot />
  </body>
</html>